## SocialDesk — STAGING environment template.
## Copy to the staging app's `.env` and fill in the blanks. Never commit the real file.
##
## Safety model: staging must never touch production data or send a real message.
##  - its own database (created fresh, never a dump of production)
##  - its own APP_KEY and Meta secrets (so production webhook signatures fail closed)
##  - META_OUTBOUND_ENABLED=false (no outbound Graph calls reach customers)
##  - no cron jobs (nothing sends or retries in the background)

APP_NAME="SocialDesk Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.socialcrm.vrindaamrit.com

## Split-directory layout: the subdomain's web root contains the contents of
## Laravel's public/ folder. Set this to that folder's ABSOLUTE path or asset(),
## the Vite manifest and storage:link resolve against the wrong directory.
APP_PUBLIC_PATH=/home/u116324493/domains/socialcrm.vrindaamrit.com/public_html/staging

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

## Staging database — create it in hPanel (Databases -> MySQL Databases) with the
## same u116324493_ prefix. NEVER point this at u116324493_socialdesk.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u116324493_socialdesk_stg
DB_USERNAME=u116324493_socialdesk_stg
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

## Shared hosting cannot hold a WebSocket process open.
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

## sync runs jobs inside the request: inbound test webhooks are processed without
## a cron worker, and outbound sending is already blocked by META_OUTBOUND_ENABLED.
## Switch to database + a cron worker only if you deliberately want to mimic the
## production queue latency.
QUEUE_CONNECTION=sync
CACHE_STORE=database

## `log` writes mail to storage/logs/laravel.log — no real emails leave staging.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="staging@vrindaamrit.com"
MAIL_FROM_NAME="${APP_NAME}"

OMNIFLOW_TRIAL_DAYS=14
OMNIFLOW_TRIAL_PLAN=growth

## ---------------------------------------------------------------------------
## Meta — staging-only values. Do NOT copy production's app secret or verify token.
## Generate fresh ones with:
##   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
## ---------------------------------------------------------------------------
META_GRAPH_VERSION=v22.0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

## Hard block: no outbound WhatsApp/Instagram/Messenger call can leave staging,
## even if a real channel account is ever present. The UI returns
## "Outbound messaging is disabled on this environment."
META_OUTBOUND_ENABLED=false

## Self-service connect is OFF while these are blank (the Channels screen offers
## only the manual token form, which you should not use with production tokens).
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_REDIRECT_URI=

## Leave blank: no real payments from staging.
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

## Reverb is unused while BROADCAST_CONNECTION=log.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST="staging.socialcrm.vrindaamrit.com"
# REVERB_PORT=443
# REVERB_SCHEME=https
