## SocialDesk — production environment template for Hostinger shared hosting.
## Copy to `.env` on the server and fill in the blanks. Never commit the real `.env`.

APP_NAME=SocialDesk
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

## Shared hosting fixes the web root at public_html. Its ABSOLUTE path goes here so
## asset(), the Vite manifest and storage:link resolve. See DEPLOY_HOSTINGER.md §3.
APP_PUBLIC_PATH=/home/u123456789/domains/yourdomain.com/public_html

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

## Hostinger MySQL. In hPanel the DB name and user are prefixed, e.g. u123456789_mytool
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=uXXXXXXXXX_omniflow
DB_USERNAME=uXXXXXXXXX_omniflow
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

## Shared hosting cannot hold a WebSocket process open, so real-time is off.
## The inbox falls back to reload-on-action. Change to `reverb` only on a VPS.
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

## Use `smtp` + Hostinger mailbox credentials to send real email; `log` writes to storage/logs.
## Port 465 -> MAIL_SCHEME=smtps (implicit TLS); port 587 -> MAIL_SCHEME=smtp (STARTTLS).
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

## App timezone is fixed to UTC in config/app.php (line ~68). Change it there if needed.

OMNIFLOW_TRIAL_DAYS=14
OMNIFLOW_TRIAL_PLAN=growth

## Meta: App Settings -> Basic -> App Secret, and a verify token you invent.
META_GRAPH_VERSION=v22.0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

## Self-service connect (WhatsApp Embedded Signup). Leave blank until the Meta app
## has passed Business Verification + App Review; the Channels screen then offers
## only the manual paste-a-token form. Set all three to enable the button.
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Must exactly match a URL in the Meta app's "Valid OAuth Redirect URIs":
# https://yourdomain.com/channels/meta/callback
META_REDIRECT_URI=

## Leave blank to keep the manual top-up flow; set later to enable Razorpay.
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

## Reverb is unused while BROADCAST_CONNECTION=log. Fill only on a VPS.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST="yourdomain.com"
# REVERB_PORT=443
# REVERB_SCHEME=https
